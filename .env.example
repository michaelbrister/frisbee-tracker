# App ports (local/docker)
FRONTEND_PORT=8080
BACKEND_PORT=8090

# Frontend -> PocketBase URL.
# Leave blank to use the current browser origin.
VITE_PB_URL=
VITE_ENABLE_OTP=true

# PocketBase bootstrap/admin settings
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me
POCKETBASE_DATA_DIR=/pb_data

# Scheduler settings
PB_URL=http://backend:8090
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me
TIMEZONE=America/New_York
GAME_TITLE=Frisbee
GAME_LOCATION=Bird Street Park
GAME_TIME=05:30 PM
SETTINGS_COLLECTION=app_settings
SETTINGS_SLUG=global
RESET_HOUR=22
