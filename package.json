{
  "name": "frisbee-tracker",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Frisbee Tracker",
  "author": "Michael Brister <mike@mikebrister.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "node --test",
    "dev": "quasar dev",
    "build": "quasar build",
    "seed:dummy": "node scheduler/reset-seed.mjs",
    "seed:wipe": "node scheduler/reset-seed.mjs --wipe-only",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.3",
    "axios": "^1.19.0",
    "luxon": "^3.7.2",
    "pinia": "^4.0.3",
    "pocketbase": "^0.28.0",
    "quasar": "^2.24.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.5.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "vite": "8.2.1",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^30 || ^28 || ^26 || ^24 || ^22.22.0",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
