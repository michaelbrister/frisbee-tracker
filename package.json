{
  "name": "frisbee-tracker",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Frisbee Tracker",
  "author": "Michael Brister <mike@mikebrister.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "node --test",
    "dev": "quasar dev",
    "build": "quasar build",
    "seed:dummy": "node scheduler/reset-seed.mjs",
    "seed:wipe": "node scheduler/reset-seed.mjs --wipe-only",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "axios": "^1.13.6",
    "luxon": "^3.7.1",
    "pinia": "^3.0.4",
    "pocketbase": "^0.26.2",
    "quasar": "^2.18.6",
    "vue": "^3.5.29",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^2.4.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "vite-plugin-checker": "^0.12.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
